"... <strong>su posición debería aparecer</strong> en el widget <em>Technician"
" Location</em>."

#: ../../../static/js/wirecloud/Tutorials/BehaviourOrientedWiring.js:192
msgid ""
"... <strong>the profile of the technician should appear</strong> in the "
"<em>Technician Profile</em> widget."
msgstr ""
"... <strong>el perfil del técnico deberá aparecer</strong> en el widget "
"<em>Technician Profile</em>."

#: ../../../static/js/wirecloud/Tutorials/BehaviourOrientedWiring.js:189
msgid "... and <strong>find him</strong> in the technician list."
msgstr "... y <strong>encontrarlo</strong> en la lista de técnicos."

#: ../../../static/js/wirecloud/Tutorials/BehaviourOrientedWiring.js:215
#: ../../../static/js/wirecloud/Tutorials/BehaviourOrientedWiring.js:235
